---
// UsaFooter.astro
---
<footer class="usa-footer usa-footer--slim border-top-1px border-base-lighter margin-top-6">
  <div class="grid-container usa-footer__return-to-top">
    <a href="#">Volver arriba</a>
  </div>
  <div class="usa-footer__primary-section">
    <div class="usa-footer__primary-container grid-row">
      <div class="tablet:grid-col-8">
        <nav class="usa-footer__nav" aria-label="Navegación del pie de página">
          <ul class="grid-row grid-gap">
            <li class="mobile-lg:grid-col-6 desktop:grid-col-auto usa-footer__primary-content">
              <a class="usa-footer__primary-link" href="https://github.com/langflow-ai/openrag" target="_blank" rel="noopener">
                IBM OpenRAG en GitHub
              </a>
            </li>
            <li class="mobile-lg:grid-col-6 desktop:grid-col-auto usa-footer__primary-content">
              <a class="usa-footer__primary-link" href="https://github.com/uswds/uswds" target="_blank" rel="noopener">
                USWDS Repositorio
              </a>
            </li>
            <li class="mobile-lg:grid-col-6 desktop:grid-col-auto usa-footer__primary-content">
              <a class="usa-footer__primary-link" href="https://mcp.docs.astro.build" target="_blank" rel="noopener">
                Astro Docs MCP
              </a>
            </li>
            <li class="mobile-lg:grid-col-6 desktop:grid-col-auto usa-footer__primary-content">
              <a class="usa-footer__primary-link" href="https://www.ibm.com/think/topics/openrag" target="_blank" rel="noopener">
                Documentación IBM watsonx
              </a>
            </li>
          </ul>
        </nav>
      </div>
      <div class="tablet:grid-col-4">
        <address class="usa-footer__address">
          <div class="usa-footer__contact-info grid-row grid-gap">
            <div class="grid-col-auto">
              <p class="font-sans-3xs text-base-light margin-0">
                Astro Theme para IBM OpenRAG con soporte de accesibilidad Section 508 y tokens de diseño federales.
              </p>
            </div>
          </div>
        </address>
      </div>
    </div>
  </div>
</footer>
